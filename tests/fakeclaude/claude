#!/usr/bin/env python3
"""The fake `claude` used by the M0-M5 suites (ORCHESTRATION.md "Fake claude for M0-M5").

It is put on PATH, or pinned in `config/claude.json`, in place of the real binary. It:

  1. records its argv, its environment and its cwd to
     `$HARNESS_ROOT/run/<id>/fake-argv.json`, so a test can assert the exact launch argv of
     spec 17.4. A Companion launch (`HX_ROLE=companion`) writes
     `fake-argv-companion.json` instead: it shares `run/<id>/` with the main session and
     starts at the same moment, so one name for both was a write-write race that left the
     file with two half-objects in it. The write is atomic for the same reason;
  2. stays alive reading stdin on a real tmux pane, appending every pasted line to
     `$HARNESS_ROOT/run/<id>/fake-input.log`, so a test can assert what `hx goal` pasted;
  3. emits scripted hook payloads, so a test can drive `hx-hook` the way a real session
     would (used from M1).

Scripted payloads come from a JSON file named by `HX_FAKE_SCRIPT`:

    [{"on": "start", "event": "stop", "payload": {"background_tasks": []}},
     {"on": "/clear", "event": "context", "payload": {"source": "clear"}}]

`on` is either `start` or the exact pasted line that triggers the payload. Each entry runs
`$HX_HOOK_BIN --id <id> <event>` with the payload as JSON on stdin and appends the result to
`$HARNESS_ROOT/run/<id>/fake-hooks.log`. M6 onward runs the real pinned binary instead.
"""

from __future__ import annotations

import datetime
import json
import os
import pathlib
import subprocess
import sys
from pathlib import Path

RECORDED_ENV_PREFIXES = ("HARNESS_", "CLAUDE_", "HX_")
RECORDED_ENV_NAMES = ("DISABLE_AUTOUPDATER", "IS_SANDBOX", "PATH", "PWD", "TMUX")


def now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def run_dir() -> Path:
    root = os.environ.get("HARNESS_ROOT")
    item_id = os.environ.get("HARNESS_ID", "unknown")
    base = Path(root) if root else Path(os.environ.get("TMPDIR", "/tmp"))
    directory = base / "run" / item_id
    directory.mkdir(parents=True, exist_ok=True)
    return directory


def recorded_env() -> dict[str, str]:
    return {
        name: value
        for name, value in os.environ.items()
        if name.startswith(RECORDED_ENV_PREFIXES) or name in RECORDED_ENV_NAMES
    }


def emit(entry: dict, target: Path) -> None:
    hook_bin = os.environ.get("HX_HOOK_BIN")
    payload = dict(entry.get("payload") or {})
    payload.setdefault("session_id", "fake-session")
    payload.setdefault("cwd", os.getcwd())
    record = {"ts": now(), "event": entry.get("event"), "payload": payload}
    if not hook_bin:
        record["error"] = "HX_HOOK_BIN is not set"
    else:
        result = subprocess.run(
            [*hook_bin.split(), "--id", os.environ.get("HARNESS_ID", "unknown"), str(entry.get("event"))],
            input=json.dumps(payload),
            capture_output=True,
            text=True,
            check=False,
        )
        record.update({"exit": result.returncode, "stdout": result.stdout, "stderr": result.stderr})
    with target.open("a") as handle:
        handle.write(json.dumps(record) + "\n")
        handle.flush()


#: The idle prompt `hx.goal.pane_is_idle` looks for. The real TUI draws a `>` input box
#: instead; `hx.goal.IDLE_PROMPTS` carries both patterns and M6 confirms the real one.
IDLE_PROMPT = "hx-fake-idle>"


def prompt() -> None:
    """Announce that the pane is waiting for input, the way a real idle TUI does."""
    sys.stdout.write(IDLE_PROMPT + "\n")
    sys.stdout.flush()


def companion_pass(line: str) -> None:
    """Play the Companion: read the pass file, write the scripted out.json, fire its hook.

    `HX_FAKE_COMPANION_SCRIPT` is a JSON list; one entry is consumed per pass. An entry is
    `{"state": {...}}` for a step state, or `{"text": "..."}` to write that verbatim (which
    is how a test drives the invalid-output path).
    """
    path = pathlib.Path(line[len("Companion pass: read "):].split(" and do what it says")[0])
    fields = {}
    for row in path.read_text().splitlines():
        if ":" in row and not row.startswith("#"):
            key, _, value = row.partition(":")
            fields[key.strip()] = value.strip()

    directory = run_dir()
    (directory / "fake-passes.log").open("a").write(json.dumps(fields) + "\n")

    script_path = os.environ.get("HX_FAKE_COMPANION_SCRIPT")
    if not script_path or not pathlib.Path(script_path).is_file():
        return
    responses = json.loads(pathlib.Path(script_path).read_text())
    if not responses:
        return
    seen = len((directory / "fake-passes.log").read_text().splitlines()) - 1
    response = responses[min(seen, len(responses) - 1)]

    out = pathlib.Path(fields.get("write", ""))
    if not out.parent.is_dir():
        return
    if "text" in response:
        out.write_text(response["text"])
    else:
        out.write_text(json.dumps(response.get("state", {})))

    hook_bin = os.environ.get("HX_HOOK_BIN")
    if hook_bin:
        subprocess.run(
            [*hook_bin.split(), "--id", os.environ.get("HARNESS_ID", "unknown"), "companion-stop"],
            input=json.dumps({"hook_event_name": "Stop", "session_id": "fake-companion"}),
            capture_output=True, text=True, check=False,
        )


def load_script() -> list[dict]:
    path = os.environ.get("HX_FAKE_SCRIPT")
    if not path or not Path(path).is_file():
        return []
    try:
        data = json.loads(Path(path).read_text())
    except json.JSONDecodeError:
        return []
    return [entry for entry in data if isinstance(entry, dict)] if isinstance(data, list) else []


#: The pinned version this fake claims to be. `hx install`, `hx upgrade` and `hx doctor` all
#: read `claude --version` and compare against the package's tested list, so the fake has to
#: answer it the way the real binary does: `<bare version> (Claude Code)`.
DEFAULT_VERSION = "2.1.280"


def main() -> int:
    if "--version" in sys.argv[1:]:
        print(f"{os.environ.get('HX_FAKE_CLAUDE_VERSION', DEFAULT_VERSION)} (Claude Code)")
        return 0

    directory = run_dir()
    # One file per role: `hx launch` starts the main session and its Companion into the same
    # `run/<id>/`, within milliseconds of each other. Sharing one name truncated one record
    # mid-write and left invalid JSON behind. The temp-and-rename keeps a reader from ever
    # seeing a partial file either.
    name = ("fake-argv-companion.json" if os.environ.get("HX_ROLE") == "companion"
            else "fake-argv.json")
    record = json.dumps(
        {
            "ts": now(),
            "argv": sys.argv[1:],
            "argv0": sys.argv[0],
            "cwd": os.getcwd(),
            "pid": os.getpid(),
            "env": recorded_env(),
        },
        indent=2,
    ) + "\n"
    tmp = directory / f".{name}.{os.getpid()}"
    tmp.write_text(record)
    os.replace(tmp, directory / name)

    script = load_script()
    hooks_log = directory / "fake-hooks.log"
    for entry in script:
        if entry.get("on", "start") == "start":
            emit(entry, hooks_log)

    input_log = directory / "fake-input.log"
    input_log.touch()
    # A real pane would show a prompt here; a test waits for this marker before pasting.
    (directory / "fake-ready").write_text(now() + "\n")
    prompt()

    holding = False
    for line in sys.stdin:
        line = line.rstrip("\n")
        with input_log.open("a") as handle:
            handle.write(line + "\n")
            handle.flush()
        for entry in script:
            if entry.get("on") == line:
                emit(entry, hooks_log)
        if line.strip().startswith("Companion pass: read "):
            companion_pass(line.strip())
            prompt()
            continue
        if line.strip() == "/fake-exit":
            break
        # `/fake-hold` leaves the pane mid-turn, with no idle prompt, the way a real session
        # looks while it is working; `/fake-release` ends the turn. This is how a test drives
        # `hx goal`'s readiness wait, which blocks until the idle prompt is back (spec 08).
        if line.strip() == "/fake-hold":
            holding = True
            continue
        if line.strip() == "/fake-release":
            holding = False
        if not holding:
            prompt()
    return 0


if __name__ == "__main__":
    sys.exit(main())
