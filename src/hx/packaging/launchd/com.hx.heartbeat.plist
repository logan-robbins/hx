<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  hx heartbeat — every 900 s: `hx board`, restart any working item whose session is dead
  (partner included), and wake the Partner when the board changed (08-hx-cli.md,
  12-partner-loop.md step 4, 17-packaging.md 17.2 step 5).

  Written by `hx install` into ~/Library/LaunchAgents/com.hx.heartbeat.plist with the
  placeholders below substituted, then loaded with:

      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.hx.heartbeat.plist

  Placeholders, substituted by `hx install` and re-rendered by `hx upgrade`:
    {HX_BIN}        absolute path of the hx entry point (config/hx.json "hx_bin")
    {HARNESS_ROOT}  absolute path of the instance

  This clock lives outside Claude Code on purpose. A session cron, /loop, or Monitor inside the
  Partner is cleared by /clear and therefore by every seam; this is not.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hx.heartbeat</string>

	<key>ProgramArguments</key>
	<array>
		<string>{HX_BIN}</string>
		<string>heartbeat</string>
	</array>

	<key>EnvironmentVariables</key>
	<dict>
		<key>HARNESS_ROOT</key>
		<string>{HARNESS_ROOT}</string>
	</dict>

	<key>WorkingDirectory</key>
	<string>{HARNESS_ROOT}</string>

	<key>StartInterval</key>
	<integer>900</integer>

	<key>RunAtLoad</key>
	<false/>

	<key>KeepAlive</key>
	<false/>

	<key>ProcessType</key>
	<string>Background</string>

	<key>StandardOutPath</key>
	<string>{HARNESS_ROOT}/run/hx-heartbeat.log</string>

	<key>StandardErrorPath</key>
	<string>{HARNESS_ROOT}/run/hx-heartbeat.log</string>
</dict>
</plist>
